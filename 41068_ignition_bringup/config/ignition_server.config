<?xml version="1.0"?>
<server_config>
  <plugins>
    <!-- Keep common Gazebo systems out of individual world files so custom
         student worlds only need to define the environment. -->
    <plugin
      entity_name="*"
      entity_type="world"
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics" />

    <plugin
      entity_name="*"
      entity_type="world"
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands" />

    <plugin
      entity_name="*"
      entity_type="world"
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster" />

    <!-- Load the Sensors system exactly once at the server/world level.
         Do not put this plugin in each robot model; doing so causes duplicate
         Ogre scene visual insertions when multiple robots are spawned. -->
    <plugin
      entity_name="*"
      entity_type="world"
      filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <plugin
      entity_name="*"
      entity_type="world"
      filename="ignition-gazebo-contact-system"
      name="ignition::gazebo::systems::Contact" />
  </plugins>
</server_config>
