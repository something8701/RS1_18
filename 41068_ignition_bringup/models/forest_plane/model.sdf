<!-- model.sdf -->
<sdf version="1.7">
<model name="grass_plane">
    <static>true</static>
    <link name="link">
        
        <collision name="collision">
            <geometry>
            <box>
                <normal>0 0 1</normal>
                <size>25 25 0.01</size>
            </box>
            </geometry>
        </collision>
        <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry>
            <plane>
                <normal>0 0 1</normal>
                <size>25 25</size>
            </plane>
            </geometry>
            <material>
                
                <ambient>1.0 1.0 1.0 1</ambient>
                <diffuse>1.0 1.0 1.0 1</diffuse>
                
                <pbr>
                    <metal>
                    <albedo_map>
                        model://forest_plane/materials/textures/forest_overhead.png
                    </albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
    </link>
</model>
</sdf>
