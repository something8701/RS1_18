<?xml version="1.0"?>
<sdf version="1.8">
  <world name="cluster_test">
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <shadows>1</shadows>
    </scene>

    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- Ground tiles: 20 x 20 m surveyable area -->
    <include>
      <uri>model://grass_plane</uri>
      <name>gnd_-5_-5</name>
      <pose>-5 -5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://grass_plane</uri>
      <name>gnd_-5_5</name>
      <pose>-5 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://grass_plane</uri>
      <name>gnd_5_-5</name>
      <pose>5 -5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://grass_plane</uri>
      <name>gnd_5_5</name>
      <pose>5 5 0 0 0 0</pose>
    </include>

    <!-- Isolated tree -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>oak_1</name>
      <pose>-7 -7 0 0 0 1.2</pose>
    </include>

    <!-- Resolvable pair: 1.8 m spacing -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>oak_2</name>
      <pose>1.5 -5 0 0 0 0.8</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree</uri>
      <name>pine_3</name>
      <pose>3.3 -5 0 0 0 2.4</pose>
    </include>

    <!-- Resolvable pair: 2.5 m spacing -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree</uri>
      <name>pine_4</name>
      <pose>-2.5 0 0 0 0 3.1</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>oak_5</name>
      <pose>0 0 0 0 0 1.9</pose>
    </include>

    <!-- Triplet: ~1.6 m equilateral -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>oak_6</name>
      <pose>-5 4 0 0 0 2.2</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree</uri>
      <name>pine_7</name>
      <pose>-3.4 4 0 0 0 1.7</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>oak_8</name>
      <pose>-4.2 5.4 0 0 0 2.8</pose>
    </include>

    <!-- Below-resolution tight pair: 1.3 m spacing (expected to merge) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>oak_9</name>
      <pose>5 4 0 0 0 2.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree</uri>
      <name>pine_10</name>
      <pose>6.3 4 0 0 0 1.5</pose>
    </include>

  </world>
</sdf>
