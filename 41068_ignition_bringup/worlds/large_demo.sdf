    <!-- Dynamic world demo models -->
    <!-- These simple marker models are manipulated by scripts/dynamic_world_demo.py.
         They are intentionally defined in this world, rather than spawned by the
         script, so the add-on node only needs to move existing Gazebo entities. -->
    <model name="demo_animal">
      <pose>-4 4 0 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <collision name="body_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <sphere><radius>0.35</radius></sphere>
          </geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <sphere><radius>0.35</radius></sphere>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.10 1</ambient>
            <diffuse>0.45 0.26 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="nose_visual">
          <pose>0.32 0 0.25 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.10</radius><length>0.25</length></cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.07 0.05 1</ambient>
            <diffuse>0.12 0.08 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="demo_tree_healthy">
      <pose>4 -4 0 0 0 0</pose>
      <static>true</static>
      <link name="tree">
        <collision name="trunk_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.18</radius><length>1.5</length></cylinder>
          </geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry>
            <sphere><radius>0.75</radius></sphere>
          </geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.18</radius><length>1.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.08 1</ambient>
            <diffuse>0.35 0.20 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry>
            <sphere><radius>0.75</radius></sphere>
          </geometry>
          <material>
            <ambient>0.05 0.45 0.08 1</ambient>
            <diffuse>0.05 0.45 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="demo_tree_fire">
      <pose>0 0 -30 0 0 0</pose>
      <static>true</static>
      <link name="tree">
        <collision name="trunk_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
