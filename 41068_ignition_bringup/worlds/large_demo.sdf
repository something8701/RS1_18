      </uri>
      <name>forest_wall7</name>
      <pose>0 -12.5 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall8</name>
      <pose>-9.32 -12.5 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
